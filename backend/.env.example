# 复制本文件为 .env 后按实际环境填写，切勿把真实 .env 提交到仓库
# cp .env.example .env

# 数据库连接串（MySQL）
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/lab_agent

# JWT 签名密钥，请替换为足够长的随机字符串，例如：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-please-generate-a-strong-random-secret

# token 有效期（小时）
JWT_EXPIRE_HOURS=24

# JWT 签名算法
JWT_ALGORITHM=HS256
